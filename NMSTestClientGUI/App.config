<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ResultDirecotry" value="../Results" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <system.diagnostics>
