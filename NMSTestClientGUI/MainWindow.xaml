<Window x:Class="NMSTestClientGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NMS Test Client — GDA GUI" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <!-- Button style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClearBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E74C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="18,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NMS Test Client" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=" — GDA Read Operations" FontSize="14" Foreground="#95A5A6" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E74C3C" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtConnectionStatus" Text="Not connected" Foreground="#BDC3C7" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS -->
        <Border DockPanel.Dock="Bottom" Background="#ECF0F1" Padding="12,5">
            <TextBlock x:Name="TxtStatus" Text="Ready." FontSize="11" Foreground="#7F8C8D"/>
        </Border>

        <!-- MAIN -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>

                    <!-- GET VALUES -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="1. Get Values" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Global ID (hex):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtGVId" Text="0x0000000700000001" Style="{StaticResource InputBox}"/>
                            <Button Content="▶  Get Values" Style="{StaticResource PrimaryBtn}" Click="BtnGetValues_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- GET EXTENT VALUES -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="2. Get Extent Values" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Entity Type:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbEVType" Style="{StaticResource InputCombo}">
                                <ComboBoxItem Content="CURVE" IsSelected="True"/>
                                <ComboBoxItem Content="CURVEDATA"/>
                                <ComboBoxItem Content="REGULARINTSCHEDULE"/>
                                <ComboBoxItem Content="REGULARTIMEPOINT"/>
                                <ComboBoxItem Content="IRREGULARINTSCHEDULE"/>
                                <ComboBoxItem Content="IRREGULARTIMEPOINT"/>
                                <ComboBoxItem Content="OUTAGESCHEDULE"/>
                                <ComboBoxItem Content="SWITCH"/>
                                <ComboBoxItem Content="SWITCHINGOPERATION"/>
                            </ComboBox>
                            <Button Content="▶  Get Extent Values" Style="{StaticResource PrimaryBtn}" Click="BtnGetExtentValues_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- GET RELATED VALUES -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="3. Get Related Values" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Source GID (hex):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtRVSourceId" Text="0x0000000600000001" Style="{StaticResource InputBox}"/>
                            <TextBlock Text="Association Property:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbRVProp" Style="{StaticResource InputCombo}">
                                <ComboBoxItem Content="CURVE_CURVEDATAS" IsSelected="True"/>
                                <ComboBoxItem Content="REGULARINTSCHEDULE_TIMEPOINTS"/>
                                <ComboBoxItem Content="IRREGULARINTSCHEDULE_TIMEPOINTS"/>
                                <ComboBoxItem Content="OUTAGESCHEDULE_SWITCHINGOPERATIONS"/>
                                <ComboBoxItem Content="SWITCHINGOPERATION_SWITCHES"/>
                            </ComboBox>
                            <TextBlock Text="Target Type:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbRVType" Style="{StaticResource InputCombo}">
                                <ComboBoxItem Content="CURVEDATA" IsSelected="True"/>
                                <ComboBoxItem Content="REGULARTIMEPOINT"/>
                                <ComboBoxItem Content="IRREGULARTIMEPOINT"/>
                                <ComboBoxItem Content="SWITCHINGOPERATION"/>
                                <ComboBoxItem Content="SWITCH"/>
                            </ComboBox>
                            <Button Content="▶  Get Related Values" Style="{StaticResource PrimaryBtn}" Click="BtnGetRelatedValues_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ALL TYPES -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="All Types" Style="{StaticResource SectionTitle}"/>
                            <Button Content="▶  Get All Types (Extent)" Style="{StaticResource PrimaryBtn}" Click="BtnGetAllTypes_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- CLEAR -->
                    <Button Content="🗑  Clear Results" Style="{StaticResource ClearBtn}" Click="BtnClear_Click" Margin="0,0,0,8"/>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Results + Log -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <!-- RESULTS -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F8F9FA" Padding="14,10" CornerRadius="6,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Results" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtResultCount" Grid.Column="1" Text="" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                            <TreeView x:Name="ResultTree" FontFamily="Consolas" FontSize="12"
                                      BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- LOG -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F8F9FA" Padding="14,8" CornerRadius="6,6,0,0">
                            <TextBlock Text="Log" FontSize="12" FontWeight="Bold" Foreground="#2C3E50"/>
                        </Border>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10,6">
                            <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                                       Foreground="#2C3E50" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
